#include <iostream>
#include <cmath>
using namespace std;
int main() {
    // Write C++ code here
    cout<<" Enter "<<endl;
    cout<<" Number 1 : ";
    float a;
    cin>>a;
    cout<<endl;
    cout<<" Number 2 : ";
    float b;
    cin>>b;
    int oper;
    cout<<" Select an Operation: 
             1 for addition
             2 for subtraction
             3 for multiplication
             4 for division"<<endl;
    cin>>oper;
    if(oper==1){
        cout<<"The sum is: "<<a+b<<endl;
    }
    else if(oper==2){
        cout<<"The difference is: "<<a-b<<endl;
    }
    else if(oper==3){
        cout<<"The product is: "<<a*b<<endl;
    }
    else if(oper==4){
        cout<<"The answer is: "<<a/b<<endl;
    }
    
    
    

    return 0;
}
